# Copy to .env.local (or set these in your host's project settings)

# Branding
VITE_AUTHOR_NAME=Abhipriyo
# Your portfolio or LinkedIn: makes every "Made by Abhipriyo" a link
VITE_AUTHOR_URL=
VITE_GITHUB_URL=

# "Work with me" page: how companies reach you
# A Cal.com or Calendly link for the "Book a call" button
VITE_CONTACT_URL=
# Where enquiries go (defaults to abhipriyo.scholasticsolutions@gmail.com, delivered via FormSubmit)
VITE_CONTACT_EMAIL=
# Optional: a Formspree (or similar) form URL to use instead of FormSubmit
VITE_FORM_ENDPOINT=

# Public address of this site (used by the "Powered by" badge in embeds)
VITE_SITE_URL=

# Optional AI for open-ended questions. Common questions are answered without it.
# Point the app at the server function:
VITE_AI_PROXY=
# Server-only secrets: set these in Vercel/Netlify environment settings, never as VITE_ variables
# ANTHROPIC_API_KEY=   (or OPENAI_API_KEY=)
# AI_MODEL=claude-haiku-5-5
# AI_HOURLY_LIMIT=30
# ALLOWED_ORIGINS=https://yourdomain.com

# Optional analytics
VITE_PLAUSIBLE_DOMAIN=
# Set to 1 on hosts with a 25 MB per-file limit (e.g. Cloudflare Pages)
VITE_DUCKDB_CDN=
