# Copy to .env.local (or set in your host's project settings)
VITE_AUTHOR_NAME=Abhipriyo
# Your portfolio / LinkedIn — used in every "Made by Abhipriyo" link
VITE_AUTHOR_URL=
# Where "Work with Abhipriyo" buttons go (Cal.com, Tally form or mailto:). The client CTA is hidden until set.
VITE_CONTACT_URL=
VITE_GITHUB_URL=
# Optional privacy-friendly analytics
VITE_PLAUSIBLE_DOMAIN=
# Set to 1 on hosts with a 25 MB per-file limit (e.g. Cloudflare Pages) to load DuckDB-WASM from jsDelivr
VITE_DUCKDB_CDN=
